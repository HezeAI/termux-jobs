*           text=auto
*.bat       text eol=crlf
*.gradle    text eol=lf
*.mk        text eol=lf
*.sh        text eol=lf

# Unified diff context lines intentionally contain a single space.
docs/fork/patches/*.patch whitespace=-blank-at-eol,-blank-at-eof

# Preserve upstream license notices byte-for-byte, including their existing whitespace.
app/src/main/assets/workspace-local-ai-notices.txt whitespace=-blank-at-eol,-blank-at-eof
docs/fork/third-party/* whitespace=-blank-at-eol,-blank-at-eof

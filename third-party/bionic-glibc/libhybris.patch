+/* Termux Jobs prototype: Bionic barriers have a different layout.
+ * Keep the glibc object on the heap; only a pointer occupies the Bionic storage.
+ * Process-shared/explicit attributes are deliberately unsupported here. */
+static int _hybris_hook_pthread_barrier_init(void *storage, const void *attr, unsigned count)
+{
+    if (!storage || !count) return EINVAL;
+    if (attr) return ENOTSUP;
+    pthread_barrier_t *barrier = malloc(sizeof(*barrier));
+    if (!barrier) return ENOMEM;
+    int result = pthread_barrier_init(barrier, NULL, count);
+    if (result) { free(barrier); return result; }
+    memcpy(storage, &barrier, sizeof(barrier));
+    return 0;
+}
+static int _hybris_hook_pthread_barrier_wait(void *storage)
+{
+    pthread_barrier_t *barrier = NULL;
+    if (!storage) return EINVAL;
+    memcpy(&barrier, storage, sizeof(barrier));
+    return barrier ? pthread_barrier_wait(barrier) : EINVAL;
+}
+static int _hybris_hook_pthread_barrier_destroy(void *storage)
+{
+    pthread_barrier_t *barrier = NULL;
+    if (!storage) return EINVAL;
+    memcpy(&barrier, storage, sizeof(barrier));
+    if (!barrier) return EINVAL;
+    int result = pthread_barrier_destroy(barrier);
+    if (!result) { free(barrier); barrier = NULL; memcpy(storage, &barrier, sizeof(barrier)); }
+    return result;
+}
 static struct _hook hooks_common[] = {
+    HOOK_INDIRECT(pthread_barrier_init),
+    HOOK_INDIRECT(pthread_barrier_wait),
+    HOOK_INDIRECT(pthread_barrier_destroy),
 
